DATABASE_URL="postgresql://depo:depo_dev_password@localhost:5432/depo_dev"
PORT=3000
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
# 32 bajtů (64 hex znaků) — node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Používá se i pro šifrování osobních údajů přihlášky (nouzový kontakt, zdravotní poznámka).
PUBLISH_TARGET_ENC_KEY="change-me-64-hex-chars"
# GDPR retenční politika (docs/08-security.md §8.7) — po kolika dnech od data
# události se přihlášky automaticky anonymizují. Výchozí 730 (2 roky).
GDPR_RETENCE_DNI=730
# Base URL veřejné webové aplikace — používá se jen pro sestavení odkazu
# uvnitř QR kódu na osobní výsledkovou stránku (viz F33/QR, docs/12-rfid-a-doporuceni.md §12.6).
WEB_APP_URL="http://localhost:5173"
# SMTP pro e-mailová oznámení o doběhu (F32, docs/12-rfid-a-doporuceni.md §12.5).
# Bez SMTP_HOST se oznámení jen tiše nepošlou (nekritická cesta).
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="vysledky@depo.app"
