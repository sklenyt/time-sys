# Kopie pro docker-compose.prod.yml — cp na .env.prod a doplnit skutečné
# hodnoty. Nikdy necommitovat .env.prod se skutečnými secrety (je v .gitignore).
# Pro managed Postgres (docs/15-produkcni-nasazeni.md §15.2) POSTGRES_*
# proměnné nejsou potřeba, jen DATABASE_URL na adresu poskytovatele.

# --- postgres service (jen pro vlastní VPS variantu, ne managed) ---
POSTGRES_USER=depo
POSTGRES_PASSWORD=zmen-me
POSTGRES_DB=depo_prod

# --- api service ---
# Aplikační role bez SUPERUSER/BYPASSRLS (docs/08-security.md §8.9) —
# NE stejná jako POSTGRES_USER výše, pokud je ten bootstrap/superuser.
DATABASE_URL=postgresql://depo:zmen-me@postgres:5432/depo_prod
PORT=3000
JWT_ACCESS_SECRET=zmen-me
JWT_REFRESH_SECRET=zmen-me-taky
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PUBLISH_TARGET_ENC_KEY=zmen-me-64-hex-znaku
GDPR_RETENCE_DNI=730
WEB_APP_URL=https://tvuj-domenu.cz
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=vysledky@tvuj-domenu.cz
